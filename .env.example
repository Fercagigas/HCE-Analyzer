# ================================
# CREDENCIALES (requeridas en runtime)
# ================================
# Nunca subas .env a Git. Sustituye los valores por los tuyos; los de abajo son placeholders.

# Anthropic (Model Gateway y augmentacion de consultas RAG)
ANTHROPIC_API_KEY=TU_CLAVE_ANTHROPIC_AQUI

# Supabase: URL del proyecto y clave general (Auth y tablas public.*)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=TU_CLAVE_SUPABASE_AQUI

# Supabase: clave de un rol de SOLO LECTURA sobre mimiciv_hosp / mimiciv_icu.
# La usa exclusivamente MimicClinicalDataProvider. Si falta, se usa SUPABASE_KEY (no recomendado).
# SUPABASE_CLINICAL_KEY=TU_CLAVE_SOLO_LECTURA_AQUI

# Supabase: clave service_role SOLO para scripts de carga (scripts/load_mimiciv.py). Nunca en el runtime.
# SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE_AQUI

# Hugging Face (opcional; embeddings/reranker se descargan igualmente sin token)
# HUGGINFACEHUB_API_TOKEN=TU_TOKEN_HF_AQUI

# ================================
# TESTS E INTEGRACION
# ================================
# HCE_DISABLE_DOTENV=1   -> no leer este fichero (tests unitarios sin credenciales)
# HCE_RUN_INTEGRATION=1  -> ejecutar tests marcados `integration` contra Supabase/Anthropic reales
# Usuario de pruebas para tests live de identidad/API (definir fuera del repo, nunca aqui):
# HCE_TEST_USER_EMAIL=
# HCE_TEST_USER_PASSWORD=

# ================================
# APLICACION
# ================================
# DEBUG=False
# LOG_LEVEL=INFO

# ================================
# MODEL GATEWAY (prefijo LLM_)
# ================================
# LLM_PROVIDER=anthropic                      # anthropic | fake (tests, demo sin red)
# LLM_MODEL_CHAIN=["claude-haiku-4-5-20251001","claude-sonnet-4-5","claude-opus-4-0"]
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=0.1
# LLM_REQUEST_TIMEOUT_S=60
# LLM_TOTAL_TIMEOUT_S=120
# LLM_MAX_RETRIES_PER_MODEL=1
# LLM_MAX_ITERATIONS=6
# LLM_MAX_TOOL_VISIBLE_CHARS=12000
# LLM_QUERY_AUGMENTATION_ENABLED=True

# ================================
# DATOS CLINICOS (prefijo CLINICAL_)
# ================================
# CLINICAL_PROVIDER=supabase_mimic            # supabase_mimic | memory (fixtures grabadas)
# CLINICAL_SOURCE_NAME=mimic-iv-demo-2.2
# CLINICAL_DEFAULT_LIMIT=100
# CLINICAL_MAX_LIMIT=200
# CLINICAL_AGGREGATE_LIMIT=50
# CLINICAL_TIMEOUT_S=30

# ================================
# API FASTAPI (prefijo API_)
# ================================
# API_HOST=127.0.0.1
# API_PORT=8000
# API_CORS_ALLOWED_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
# API_DOCS_ENABLED=True
# API_SSE_PING_S=15
# API_READY_CACHE_S=300
# API_MAX_BODY_BYTES=65536
# API_ENVIRONMENT=dev                         # dev | prod (mensajes de error genericos)

# ================================
# AUDITORIA (prefijo AUDIT_)
# ================================
# AUDIT_SINK=jsonl                            # jsonl | stdout | null
# AUDIT_DIRECTORY=logs/audit

# ================================
# RAG
# ================================
# RAG_MODEL=claude-haiku-4-5-20251001
# RAG_MAX_TOKENS=4000
# RAG_TEMPERATURE=0.1
# RAG_API_TIMEOUT_SECONDS=60
# QUERY_AUGMENTATION_ENABLED=True
# QUERY_AUGMENTATION_MODEL=claude-haiku-4-5-20251001
# QUERY_AUGMENTATION_MAX_QUERIES=3

# ================================
# SEGURIDAD Y LIMITES (rate limit por usuario)
# ================================
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_PER_HOUR=300
# MAX_MESSAGE_LENGTH=5000
# BURST_LIMIT=5
# BURST_WINDOW_SECONDS=10
# LOCKOUT_DURATION_SECONDS=900
# SESSION_TIMEOUT=3600

# ================================
# NOTIFICACIONES (opcional, sin uso en el runtime actual)
# ================================
# SMTP_SERVER=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ================================
# INSTRUCCIONES
# ================================
# 1. Copia este fichero como .env en la raiz del proyecto.
# 2. Rellena ANTHROPIC_API_KEY, SUPABASE_URL y SUPABASE_KEY (y SUPABASE_CLINICAL_KEY si ya existe el rol de solo lectura).
# 3. Aplica db/migrations/0001 y 0002 en el SQL Editor de Supabase (ver db/README.md).
# 4. Comprueba la configuracion:
#      conda activate HCE ; python -c "from config.settings import get_settings; s=get_settings(); print(s.require_database().supabase_url)"
# 5. Arranca: `streamlit run main.py` o `python -m uvicorn chathce.api.app:app --host 127.0.0.1 --port 8000 --workers 1`
